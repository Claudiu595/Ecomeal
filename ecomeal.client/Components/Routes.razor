@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@rendermode InteractiveServer

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(ecomeal.client.Components.Layout.MainLayout)">
                <NotAuthorized>
                    <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                            @if (context.User.Identity?.IsAuthenticated == true)
                            {
                                <span>Nu ai permisiunile necesare pentru a accesa această pagină.</span>
                            }
                            else
                            {
                                <span>Trebuie să te autentifici pentru a accesa această pagină. <a href="/login">Autentifică-te</a></span>
                            }
                        </MudAlert>
                    </MudContainer>
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center py-8">
                        <MudProgressCircular Indeterminate="true" Color="Color.Success" />
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
